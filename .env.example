# Configuración para usar un modelo local vía Ollama (ollama.com).
# Requiere `ollama serve` corriendo y el modelo descargado (`ollama pull <modelo>`).

# URL del servidor de Ollama (opcional, tiene default en el código)
OLLAMA_HOST=http://localhost:11434

# Modelo a usar en las llamadas del toolkit (opcional, tiene default en el código)
OLLAMA_MODEL=llama3.1
