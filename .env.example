# Configuration for using a local model via Ollama (ollama.com).
# Requires `ollama serve` running and the model pulled (`ollama pull <model>`).

# Ollama server URL (optional, has a default in code)
OLLAMA_HOST=http://localhost:11434

# Model used by the toolkit's calls (optional, has a default in code)
OLLAMA_MODEL=llama3.1
